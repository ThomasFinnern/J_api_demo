<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
  <name>com_secondhand</name>
  <element>com_secondhand</element>
  <author>Steven Smith</author>
  <creationDate>2026.05.27</creationDate>
  <copyright>(C) 2026-2026 Steven Smith</copyright>
  <license>GNU General Public License version 3 or later</license>
  <authorEmail>steven_smith@dummy.com</authorEmail>
  <authorUrl>https://smith14639@whatever.com</authorUrl>
  <version>0.1.0.1</version>
  <description>COM_SECONDHAND_XML_DESCRIPTION</description>
  <namespace path="src">Bluebox\Component\Secondhand</namespace>
  <install>
    <!-- Runs on install -->
    <sql>
      <file charset="utf8" driver="mysql">sql/install.mysql.utf8.sql</file>
    </sql>
  </install>
  <uninstall>
    <!-- Runs on uninstall -->
    <sql>
      <file charset="utf8" driver="mysql">sql/uninstall.mysql.utf8.sql</file>
    </sql>
  </uninstall>
  <update>
    <!-- Runs on update -->
    <schemas>
      <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>
  </update>
  <administration>
    <menu img="class:fas fa-cog">COM_SECONDHAND</menu>
    <submenu>
      <menu view="books">COM_SECONDHAND_MENU_BOOKS<params><menu-quicktask-title>COM_SECONDHAND_NEW_BOOK</menu-quicktask-title><menu-quicktask-icon>fas fa-book</menu-quicktask-icon><menu-quicktask>index.php?option=com_secondhand&amp;task=book.add</menu-quicktask></params>
	  </menu>
    </submenu>
    <files folder="administrator">
      <filename>access.xml</filename>
      <!--filename>changelog.xml</filename-->
      <filename>config.xml</filename>
      <filename>LICENSE.txt</filename>
      <filename>secondhand.xml</filename>
      <!--filename>script.php</filename-->
      <folder>forms</folder>
      <folder>language</folder>
      <folder>services</folder>
      <folder>sql</folder>
      <folder>src</folder>
      <folder>tmpl</folder>
    </files>
  </administration>
  <api>
    <files folder="api">
      <folder>src</folder>
    </files>
  </api>
  <!--changelogurl>/com_secondhand/changelog.xml</changelogurl-->
  <!--updateservers>
    <server type="extension" priority="1" name="secondhand Updates">https://YOUR-UPDATE-URL.COM/com_secondhand/extension.xml</server>
  </updateservers-->
</extension>
